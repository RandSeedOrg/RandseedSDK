{
  "name": "@randseed/server-sdk",
  "version": "0.2.0-beta.0",
  "private": true,
  "description": "RandSeed Node.js game server SDK",
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "files": [
    "node/README.md",
    "node/dist",
    "protocol"
  ],
  "types": "./node/dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./node/dist/index.d.ts",
      "import": "./node/dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc --project node/tsconfig.json",
    "test": "npm run build && node --test node/test/*.test.mjs",
    "prepare": "npm run build"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "typescript": "~5.8.2"
  }
}
